{
  "name": "ledgerbook",
  "productName": "Ledgerbook",
  "version": "2.0.1",
  "description": "GST billing, inventory and returns for small businesses",
  "author": "Sourabh Tilawat",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.ledgerbook.billing",
    "productName": "Ledgerbook",
    "copyright": "Developed by Sourabh Tilawat",
    "files": ["main.js", "preload.js", "server.js", "www/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ledgerbook",
      "artifactName": "Ledgerbook-Setup-${version}.exe"
    }
  }
}
